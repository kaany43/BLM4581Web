@page "{id:int}"
@model BLM4581Web.Pages.Kitaplar.DuzenleModel
@{
    ViewData["Title"] = "Kitap Düzenle";
}
 
<h1>Kitap Düzenle</h1>
 
<form method="post">
    <div class="mb-3">
        <label asp-for="DuzenlenenKitap.Ad" class="form-label"></label>
        <input asp-for="DuzenlenenKitap.Ad" class="form-control" />
        <span asp-validation-for="DuzenlenenKitap.Ad" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DuzenlenenKitap.Yazar" class="form-label"></label>
        <input asp-for="DuzenlenenKitap.Yazar" class="form-control" />
        <span asp-validation-for="DuzenlenenKitap.Yazar" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DuzenlenenKitap.KategoriId" class="form-label"></label>
        <select asp-for="DuzenlenenKitap.KategoriId" asp-items="Model.Kategoriler"
                class="form-select">
            <option value="">-- Kategori seçiniz --</option>
        </select>
        <span asp-validation-for="DuzenlenenKitap.KategoriId" class="text-danger"></span>
    </div>

    @* BasimYili ve SayfaSayisi için aynı üç satır *@
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-page="Index" class="btn btn-secondary">Vazgeç</a>
</form>
 
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
