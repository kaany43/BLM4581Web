@page "{id:int}"
@model BLM4581Web.Pages.Kitaplar.DetayModel
@{
    ViewData["Title"] = "Kitap Detayı";
}

<h1>@Model.SeciliKitap.Ad</h1>

<dl class="row">
    <dt class="col-sm-3">Yazar</dt>
    <dd class="col-sm-9">@Model.SeciliKitap.Yazar</dd>
    <dt class="col-sm-3">Kategori</dt>
    <dd class="col-sm-9">@Model.SeciliKitap.Kategori?.Ad</dd>
    <dt class="col-sm-3">Basım Yılı</dt>
    <dd class="col-sm-9">@Model.SeciliKitap.BasimYili</dd>
    <dt class="col-sm-3">Sayfa Sayısı</dt>
    <dd class="col-sm-9">@Model.SeciliKitap.SayfaSayisi</dd>
</dl>

<a asp-page="Index">Listeye dön</a>
