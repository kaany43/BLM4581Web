@page "{id:int}"
@model BLM4581Web.Pages.Kitaplar.SilModel
@{
    ViewData["Title"] = "Kitap Sil";
}
 
<h1>Kitap Sil</h1>
 
<div class="alert alert-warning">
    <strong>@Model.SeciliKitap.Ad</strong> (@Model.SeciliKitap.Yazar)
    silinecek. Emin misiniz?
</div>
 
<form method="post">
    <button type="submit" class="btn btn-danger">Evet, sil</button>
    <a asp-page="Index" class="btn btn-secondary">Vazgeç</a>
</form>
